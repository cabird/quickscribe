# Ignore all dotfiles
.*

*.llm_update
*.log
*.bak
__pycache__

query_result*

# But don't ignore .gitignore
!.gitignore

# Virtual environments (at any level in the repo)
venv/
.venv/

# Node modules (at any level in the repo)
node_modules/

# Scratch/temporary work directory
scratch/

# Local experiment workspace (large; not part of the app)
diarization_experiment/

# Local copies of production data pulled by v2/deploy/scripts/download-db.sh
v2/data/
v2/exports/

# Screenshots and scratch files
*.png
foo

# Generated reports
scripts/consistency_report.json
